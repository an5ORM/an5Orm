{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "newLine": "lf",
    "declaration": true,
    "types": ["node"]
  },
  "include": [
    "cli.ts",
    "push.ts",
    "pull.ts",
    "migrate.ts",
    "cleanup.ts",
    "seed.ts",
    "provider-support.ts",
    "generator/src/**/*.ts"
  ]
}
