{
  "name": "@an5/orm",
  "version": "1.3.5",
  "description": "The lightweight ORM for SQL Server with support for TypeScript, Python, .NET (C#), Go, Rust, Java, Kotlin, and Swift.",
  "license": "MIT",
  "bin": {
    "an5": "./dist/cli.js",
    "an5-orm": "./dist/cli.js",
    "orm": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generator": {
      "types": "./dist/generator/src/api.d.ts",
      "default": "./dist/generator/src/api.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.{js,d.ts}",
    "generator/src/**/*.ts",
    "README.md"
  ],
  "author": "an5ORM",
  "homepage": "https://github.com/an5ORM/an5",
  "repository": {
    "type": "git",
    "url": "https://github.com/an5ORM/an5Orm.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p generator/tsconfig.json && tsc -p tsconfig.cli.json && node scripts/normalize-eol.js",
    "typecheck:cli": "tsc -p tsconfig.cli.json",
    "pretest": "npm run build",
    "prepack": "npm run build && npm run verify:pack",
    "prepublishOnly": "npm run verify:pack",
    "generate": "node dist/cli.js generate",
    "db:push": "node dist/cli.js db:push",
    "db:pull": "node dist/cli.js db:pull",
    "db:seed": "node dist/cli.js db:seed",
    "db:cleanup": "node dist/cli.js db:cleanup",
    "db:migrate": "node dist/cli.js db:migrate",
    "db:migrate:diff": "node dist/cli.js db:migrate diff",
    "db:migrate:generate": "node dist/cli.js db:migrate generate",
    "db:migrate:apply": "node dist/cli.js db:migrate apply",
    "db:migrate:rollback": "node dist/cli.js db:migrate rollback",
    "db:migrate:status": "node dist/cli.js db:migrate status",
    "release:cli": "npx tsx scripts/release-cli.ts",
    "release": "node scripts/release.js",
    "test": "npm run typecheck:cli && node test/smoke.test.js && node test/unit.test.js && node test/generator-regressions.test.js && node --test test/config.test.js && node --test test/cli.test.js && node --test test/provider-types.test.js && node --test test/provider-push.test.js && node --test test/provider-push.sqlite.test.js && node --test test/type-kinds.test.js && node --test test/declarations.test.js && node --test test/version-sync.test.js && node --test test/query-semantics.test.js",
    "test:unit": "node test/unit.test.js",
    "test:generator": "npm run generate && node test/generator.test.js",
    "test:generator:regressions": "node test/generator-regressions.test.js",
    "test:provider-types": "node --test test/provider-types.test.js",
    "test:provider-push": "node --test test/provider-push.test.js",
    "test:provider-push:sqlite": "node --test test/provider-push.sqlite.test.js",
    "test:integration:live": "node test/live-db.integration.test.js",
    "verify:pack": "node scripts/verify-pack.js",
    "normalize:eol": "node scripts/normalize-eol.js"
  },
  "dependencies": {
    "@an5/adapters": "^0.2.6",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "mssql": "^12.5.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mssql": "^9.1.8",
    "@types/node": "^20.19.43",
    "tsx": "^4.7.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
