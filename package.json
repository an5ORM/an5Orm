{
  "name": "@an5/orm",
  "version": "1.0.8",
  "description": "The lightweight ORM for SQL Server with support for TypeScript, Python, .NET (C#), and Go.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.{js,d.ts}",
    "generator/src/**/*.ts",
    "README.md"
  ],
  "author": "an5ORM",
  "homepage": "https://github.com/an5ORM/an5",
  "repository": {
    "type": "git",
    "url": "https://github.com/an5ORM/an5Orm.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "generate": "npx tsx generator/src/index.ts",
    "db:push": "npx tsx push.ts",
    "db:pull": "npx tsx pull.ts",
    "db:seed": "npx tsx seed.ts",
    "db:cleanup": "npx tsx cleanup.ts",
    "db:migrate": "npx tsx migrate.ts",
    "db:migrate:diff": "npx tsx migrate.ts diff",
    "db:migrate:generate": "npx tsx migrate.ts generate",
    "db:migrate:apply": "npx tsx migrate.ts apply",
    "db:migrate:rollback": "npx tsx migrate.ts rollback",
    "db:migrate:status": "npx tsx migrate.ts status",
    "release:cli": "npx tsx scripts/release-cli.ts",
    "release": "node scripts/release.js",
    "test": "node test/smoke.test.js && node test/unit.test.js",
    "test:unit": "node test/unit.test.js",
    "test:generator": "npm run generate && node test/generator.test.js",
    "test:integration:live": "node test/live-db.integration.test.js"
  },
  "dependencies": {
    "@an5/adapters": "^0.2.5",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "mssql": "^12.5.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mssql": "^9.1.8",
    "@types/node": "^20.19.43",
    "tsx": "^4.7.1",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
